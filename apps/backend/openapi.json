  "info": {
    "title": "Timesheet app API",
    "description": "Backend for the timesheet UI. Wraps the upstream time-tracking API. Errors always have the shape { error: { code, message, fields? } }.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ApiErrorDetails": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "VALIDATION_FAILED"
          },
          "message": {
            "type": "string",
            "example": "Some fields need attention"
          },
          "fields": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "example": {
              "end": "End must be after start."
            },
            "description": "One message per invalid field"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "ApiErrorBody": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiErrorDetails"
          }
        },
        "required": [
          "error"
        ]
      },
      "Client": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 3
          },
          "name": {
            "type": "string",
            "example": "Client 3"
          },
          "description": {
            "type": "string",
            "example": "This is the description for client 3."
          },
          "status": {
            "type": "string",
            "example": "in-progress",
            "description": "in-progress, pending or completed"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "PageInfo": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "number",
            "example": 10
          },
          "offset": {
            "type": "number",
            "example": 0
          },
          "hasMore": {
            "type": "boolean",
            "description": "True when a next page exists (the upstream gives no total count)"
          }
        },
        "required": [
          "limit",
          "offset",
          "hasMore"
        ]
      },
      "ClientsPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Client"
            }
          },
          "page": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": [
          "items",
          "page"
        ]
      },
      "Project": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 106
          },
          "clientId": {
            "type": "number",
            "example": 3
          },
          "name": {
            "type": "string",
            "example": "Project 3 for Client 3"
          },
          "status": {
            "type": "string",
            "example": "pending"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "clientId",
          "name",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "ProjectsPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Project"
            }
          },
          "page": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": [
          "items",
          "page"
        ]
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 405
          },
          "projectId": {
            "type": "number",
            "nullable": true,
            "example": 106
          },
          "name": {
            "type": "string",
            "example": "Task 2 for Project 106"
          },
          "status": {
            "type": "string",
            "example": "pending"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "projectId",
          "name",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "TasksPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "page": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": [
          "items",
          "page"
        ]
      },
      "TaskContext": {
        "type": "object",
        "properties": {
          "task": {
            "$ref": "#/components/schemas/Task"
          },
          "project": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Project"
              }
            ]
          },
          "client": {
            "nullable": true,
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Client"
              }
            ]
          }
        },
        "required": [
          "task",
          "project",
          "client"
        ]
      },
      "TimeEntry": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 4,
            "description": "Can be 0"
          },
          "taskId": {
            "type": "number",
            "example": 405
          },
          "comment": {
            "type": "string",
            "example": "Reviewed export edge cases"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-30T09:00:00.000Z"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "example": "2026-10-30T10:30:00.000Z"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "taskId",
          "comment",
          "start",
          "end",
          "createdAt",
          "updatedAt"
        ]
      },
      "TimeEntriesPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TimeEntry"
            }
          },
          "page": {
            "$ref": "#/components/schemas/PageInfo"
          }
        },
        "required": [
          "items",
          "page"
        ]
      },
      "TimeEntryInputDto": {
        "type": "object",
        "properties": {
          "taskId": {
            "type": "number",
            "example": 405
          },
          "comment": {
            "type": "string",
            "example": "Reviewed export edge cases",
            "maxLength": 1000
          },
          "start": {
            "type": "string",
            "example": "2026-10-30T09:00:00.000Z",
            "description": "ISO 8601"
          },
          "end": {
            "type": "string",
            "example": "2026-10-30T10:30:00.000Z",
            "description": "ISO 8601, after start"
          }
        },
        "required": [
          "taskId",
          "comment",
          "start",
          "end"
        ]
      }
    }
  }
}
